# Runtime/generated files
logs/*
runs/*
tmp/*
/.omx/

# Python bytecode caches (generated by compileall / running check scripts)
__pycache__/
*.py[cod]

# Python build/packaging artifacts
build/
dist/
*.egg-info/

# GJC / ultragoal session runtime state
/.gjc/

# Executor runtime prompts/logs belong under ignored runtime directories.
/tmp/executor-prompts/
/tmp/executor-runs/

# Project repositories are managed outside this control-plane repo.
# Canonical location: ~/projects/<project>
# Keep this ignored in case a local root-level projects/ folder or symlink is created here.
/projects/

# LLM Wiki raw material that may contain private transcripts, executor logs, or unsanitized sources
/wiki/raw/private/
/wiki/raw/sessions/
/wiki/raw/executor-runs/


# Personal research outputs kept local by default
/research/
/wiki/private/
/wiki/reports/
/wiki/queries/*
!/wiki/queries/ontology-informed-wiki-rationale-2026-05-11.md
/ai_consumer_app_niche_opportunities_ko.md
/kfashion_overseas_ai_opportunities_ko.md
/hallyu2024.txt
/browser-profiles/
/research_codex_omx/

# Large/source documents
*.pdf

# Keep directory placeholders
!logs/.gitkeep
!runs/.gitkeep
!tmp/.gitkeep

# Secrets and local overrides
.env
*.env
*.env.*
secrets/
*.key
*.pem
auth.json

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
